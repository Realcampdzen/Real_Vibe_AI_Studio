# =============================================================================
# Real Vibe AI Studio — .env.example
# =============================================================================
# Скопируй в .env и заполни значения
# ВАЖНО: .env НЕ коммитится в git (.gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# OpenAI
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-your_key_here
# Optional for VPS regions where direct OpenAI access is blocked.
# Example: socks5h://127.0.0.1:1080
OPENAI_PROXY_URL=
# Optional OpenAI-compatible gateway base URL.
OPENAI_BASE_URL=

# -----------------------------------------------------------------------------
# Google Gemini (резервный AI-провайдер)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Google OAuth
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an Authorized redirect URI in Google Cloud Console exactly.
# Production: https://real-vibe.studio/api/auth/google/callback
# Local dev: http://127.0.0.1:4347/api/auth/google/callback
GOOGLE_REDIRECT_URI=https://real-vibe.studio/api/auth/google/callback

# -----------------------------------------------------------------------------
# Яндекс OAuth
# Redirect URI in Yandex OAuth app:
# Production: https://real-vibe.studio/api/auth/yandex/callback
# Local dev: http://127.0.0.1:4347/api/auth/yandex/callback
# -----------------------------------------------------------------------------
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://real-vibe.studio/api/auth/yandex/callback
YANDEX_SCOPE=login:info login:email login:avatar

# -----------------------------------------------------------------------------
# VK ID OAuth
# Redirect URI in VK ID app:
# Production: https://real-vibe.studio/api/auth/vk/callback
# Local dev: http://127.0.0.1:4347/api/auth/vk/callback
# -----------------------------------------------------------------------------
VK_CLIENT_ID=
VK_REDIRECT_URI=https://real-vibe.studio/api/auth/vk/callback
VK_SCOPE=email phone

# -----------------------------------------------------------------------------
# Supabase
# USE_SUPABASE=false → JSON-файлы (local dev)
# USE_SUPABASE=true  → Supabase Postgres (staging/prod)
# -----------------------------------------------------------------------------
USE_SUPABASE=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# PostgreSQL (VPS Docker)
# -----------------------------------------------------------------------------
POSTGRES_DB=real_vibe
POSTGRES_USER=real_vibe
POSTGRES_PASSWORD=change_me_strong_postgres_password
POSTGRES_PORT=5432
DATABASE_URL=
# DATABASE_SSL=false
# DATABASE_POOL_MAX=10

# -----------------------------------------------------------------------------
# Auth / JWT
# В prod заменить на сильные случайные секреты (min 32 chars)
# -----------------------------------------------------------------------------
AUTH_SECRET=change_me_min_32_chars_random_string
AUTH_JWT_SECRET=change_me_min_32_chars_jwt_secret
AUTH_GENERATE_SECRET=change_me_min_32_chars_generate
AUTH_SESSION_SECRET=change_me_min_32_chars_session_secret
AUTH_SESSION_TTL_DAYS=30
TELEGRAM_LOGIN_BOT_USERNAME=
TELEGRAM_LOGIN_BOT_TOKEN=

# -----------------------------------------------------------------------------
# Telegram — НейроВалюша (основной бот)
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_CHANNEL_ID_USERNAME=
TELEGRAM_USER_ID=
TELEGRAM_WEBHOOK_SECRET=
DISCUSSION_GROUP_ID=

# -----------------------------------------------------------------------------
# Order notifications
# -----------------------------------------------------------------------------
ORDER_TELEGRAM_BOT_TOKEN=
ORDER_TELEGRAM_CHAT_ID=

# -----------------------------------------------------------------------------
# Telegram — Агенты-боты (лобстеры)
# -----------------------------------------------------------------------------
NEUROVALYUSHA_AGENT_BOT_TOKEN=
NEUROVALYUSHA_AGENT_WEBHOOK_SECRET=
NEURO_STEPA_BOT_TOKEN=
NEURO_STEPA_WEBHOOK_SECRET=
CAT_BRO_BOT_TOKEN=
CAT_BRO_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# VK
# -----------------------------------------------------------------------------
VK_API_TOKEN=
VK_USER_TOKEN=
VK_ACCESS_TOKEN=
VK_SECRET=
VK_GROUP_ID=

# -----------------------------------------------------------------------------
# App / Build
# -----------------------------------------------------------------------------
NODE_ENV=development
VITE_API_BASE_URL=/api
# VITE_BACKEND_URL=https://your-backend.vercel.app

# -----------------------------------------------------------------------------
# Image generation
# IMAGE_PROVIDER: openai | fusion_brain | yandex_art | gigachat | alice
# -----------------------------------------------------------------------------
IMAGE_PROVIDER=openai

# -----------------------------------------------------------------------------
# Rate limits (можно переопределить для prod)
# -----------------------------------------------------------------------------
# CHAT_MSG_RATE_LIMIT_PER_MIN=15
# CHAT_MESSAGES_PER_DAY=50
CHAT_DAILY_LIMIT_PER_BOT=5
CHAT_QUOTA_STORE_PATH=data/chat-quotas.json
CHAT_LIMIT_TIMEZONE=Europe/Moscow
# Secret owner token for unlimited site chat access. Set only in VPS/local .env.
CHAT_OWNER_TOKEN=
# Owner-only Hermes wellness core route. Keep these server-side only.
HERMES_WELLNESS_GATEWAY_URL=http://127.0.0.1:8649/v1/chat/completions
HERMES_WELLNESS_API_KEY=
HERMES_WELLNESS_MODEL=gpt-5.3-codex
HERMES_WELLNESS_TIMEOUT_MS=90000
# Production webhook secret for /api/webhook/:botId. Send as X-RV-Webhook-Token.
RV_WEBHOOK_TOKEN=
# Optional token that enables price dashboard writes outside local development.
# Send it as X-RV-Admin-Token from trusted admin tooling only.
RV_PRICE_EDITOR_TOKEN=
# Main Express JSON parser limit. Keep small unless an endpoint needs larger payloads.
REQUEST_BODY_LIMIT=256kb
# CSP violation report body limit.
CSP_REPORT_BODY_LIMIT=16kb
# Set to false only after validating the strict policy in production.
CSP_REPORT_ONLY=true

# -----------------------------------------------------------------------------
# Dev
# -----------------------------------------------------------------------------
VITE_DEV_EMAILS=
VITE_DEV_PIN=

# -----------------------------------------------------------------------------
# GitHub (для CI/CD)
# -----------------------------------------------------------------------------
GITHUB_TOKEN=
