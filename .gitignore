# =============================================================================
# Real Vibe AI Studio — .gitignore
# =============================================================================

# OS files
.DS_Store
Thumbs.db

# Secrets
.env
apikey.txt

# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
data/*
!data/
!data/service-prices.json
.playwright-mcp/

# Editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temp dev files
*_temp.css
*_backup.css
*_fixed.css
debug*.html
test-*.html
fix-*.html

# Task / orchestration state
tasks.json
tasks/
.cursor/worktrees.json
.cursor/rules/taskmaster/hamster.mdc
.taskmaster/docs/hero_animation_prd.txt

# Deployment artifacts
deploy-ready/
files-to-upload.txt

# Cloudflare API (local work only)
cf-api/

# Archived documentation (from refactoring cleanup)
docs/archive/

# Wrangler local state
.wrangler/
