  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "dev:simple": "npx http-server . -p 3001 -c-1 --cors",
    "check": "node scripts/check-js.mjs && node scripts/check-static.mjs",
    "check:security": "node scripts/check-static.mjs",
    "audit:prod": "npm audit --omit=dev --json",
    "smoke:api": "node scripts/api-smoke.mjs",
    "smoke:auth-cart": "node scripts/auth-cart-smoke.mjs",
    "smoke:audit": "node scripts/audit-smoke.mjs",
    "smoke:browser": "node scripts/browser-smoke.mjs",
    "smoke:prod": "node scripts/prod-smoke.mjs",
    "perf:desktop": "node scripts/perf-probe.mjs",
    "deploy:vps:patch": "node scripts/deploy-vps-patch.mjs",
    "quality:release": "npm run check && npm run check:security && npm run audit:prod",
    "test": "npm run check"
  },
  "repository": {
    "type": "git",
